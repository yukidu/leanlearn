{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leanlearn",
  "main": "./worker.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leanlearn-db",
      "database_id": "a1859c93-54ae-4495-ad03-0a3195a4f549"
    }
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "production",
    "DEMO_MODE": "true"
  }
}
